extends "res://tools/world/validate_crime_perception.gd"
## Invisible physical obstacles exercise the production station route API.
func run() -> void:
	create_timer(90).timeout.connect(func():root.get_node("SaveManager").quit_game(2))
	var station:=Node3D.new();root.add_child(station);current_scene=station
	var staff:=Node3D.new();station.add_child(staff)
	var coordinator:Node=load("res://world/suryagarh/settlements/police_arrest.gd").new()
	staff.add_child(coordinator);coordinator.set_physics_process(false)
	var floor_body:=StaticBody3D.new();station.add_child(floor_body)
	var floor_shape:=CollisionShape3D.new();floor_shape.shape=BoxShape3D.new()
	floor_shape.shape.size=Vector3(60,.2,60);floor_shape.position.y=-.1;floor_body.add_child(floor_shape)
	await sync()
	var start:=Vector3(0,0,0)
	var goal:=Vector3(0,0,4)
	var initial:PackedVector3Array=coordinator.path(start,goal,.29)
	check(not initial.is_empty() and initial[-1]==goal,"clear station route reaches exact destination")
	var obstacle:=StaticBody3D.new();obstacle.position=Vector3(0,1,2);station.add_child(obstacle)
	var shape:=CollisionShape3D.new();shape.shape=BoxShape3D.new();shape.shape.size=Vector3(2,2,.6);obstacle.add_child(shape)
	await sync()
	var updated:PackedVector3Array=coordinator.path(start,goal,.29)
	var all_clear:=not updated.is_empty()
	for point in updated:all_clear=all_clear and coordinator.clear_at(point,.29)
	check(all_clear and updated[-1]==goal,"cached route replans around newly closed obstacle")
	obstacle.position=Vector3(0,1,4)
	await sync()
	check(coordinator.path(start,goal,.29).is_empty(),"occupied destination cannot masquerade as successful arrival nearby")
	obstacle.queue_free();await sync()
	var reopened:PackedVector3Array=coordinator.path(start,goal,.29)
	check(not reopened.is_empty() and reopened[-1]==goal,"opened route reaches exact destination again")
	station.queue_free();await sync()
	# Also exercise the authored building, complete MPFB staff and real porch.
	var world:=Node3D.new();root.add_child(world);current_scene=world
	var clock:=GameTimeSystem.new();clock.name="GameTimeSystem";world.add_child(clock);clock.set_process(false)
	var building:Node3D=load("res://world/suryagarh/settlements/civic_building.gd").new()
	building.police=true;world.add_child(building)
	await sync()
	var actual:Node=building.get_node("ThanaStaff/ArrestCoordinator")
	actual.set_physics_process(false)
	for person in actual.get_parent().get_children():
		if person is Node3D and person.has_method("palm_world"):actual.exclusions.append(person.body_collider.get_rid())
	var porch:=building.to_global(Vector3(0,0,20))
	check(actual.clear_at(porch,.43),"authored station release porch retains full body clearance")
	var authored:PackedVector3Array=actual.path(building.to_global(Vector3(9.5,0,9)),porch,.29)
	check(not authored.is_empty() and authored[-1]==porch,"authored station route reaches exact release porch")
	var player:CharacterBody3D=load("res://player/player.tscn").instantiate();world.add_child(player)
	player.set_physics_process(false)
	player.global_position=building.to_global(Vector3(4,.9,15.8))
	actual.exclusions.append(player.get_rid())
	actual.suspect=player;actual.detention=player.get_node("DetentionComponent")
	actual.officer=building.get_node("ThanaStaff/Daroga")
	actual.cinematic_transfers=false
	actual.gate=building.get_node("GroundCell0Gate")
	actual.gate.set_locked(true)
	await create_timer(.7).timeout
	actual.route=[];actual.route_index=0
	actual.set_phase("escort")
	actual._physics_process(.1)
	check(actual.phase=="escort" and actual.gate.opened,"physical escort waits for opening collision before planning cell entry")
	var occupied:=StaticBody3D.new();occupied.position=Vector3(7.2,1,15.2);building.add_child(occupied)
	var occupied_shape:=CollisionShape3D.new();occupied_shape.shape=BoxShape3D.new();occupied_shape.shape.size=Vector3(.8,2,.8);occupied.add_child(occupied_shape)
	await create_timer(.7).timeout;await sync()
	actual._physics_process(.1)
	check(actual.phase=="idle","occupied cell aborts safely instead of advancing an empty path into custody")
	occupied.queue_free();await sync()
	actual.gate.set_locked(true);await create_timer(.7).timeout
	actual.set_phase("stand");actual.phase_age=1.3
	actual._physics_process(.1)
	check(actual.phase=="stand" and not actual.gate.locked,"release waits for unlocked gate collision to finish opening")
	await create_timer(.7).timeout;await sync()
	actual._physics_process(.1)
	check(actual.phase=="leave_cell" and not actual.route.is_empty(),"physical release plans a real route after the gate opens")
	actual.abort()
	world.queue_free();await sync()
	print("STATION NAVIGATION ",JSON.stringify({"checks":count,"status":"PASS" if failures.is_empty() else "FAIL","failures":failures}))
	root.get_node("SaveManager").quit_game(0 if failures.is_empty() else 1)
